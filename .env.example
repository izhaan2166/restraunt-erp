# ─── RestaurantOS API ───────────────────────────────────────────────
# Copy to `.env` (repo root, for docker compose) or `apps/api/.env` (local dev).
# Never commit real secrets.

NODE_ENV=development
PORT=4000

# PostgreSQL (docker compose overrides the host to `postgres`)
DATABASE_URL=postgresql://ros:ros_dev_password@localhost:5432/restaurant_os?schema=public
POSTGRES_PASSWORD=ros_dev_password
REDIS_URL=redis://localhost:6379

# JWT – generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_ISSUER=restaurant-os
JWT_AUDIENCE=restaurant-os-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_MAX_AGE_SECONDS=2592000

# Login protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_RESET_TTL_SECONDS=1800
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10

# HTTP
CORS_ORIGINS=http://localhost:3000
# COOKIE_SECURE defaults to true in production
# COOKIE_SECURE=true
# Set true behind a load balancer / reverse proxy so client IPs are logged correctly
TRUST_PROXY=false
APP_PUBLIC_URL=http://localhost:3000

# Mail: `log` writes messages to the log (dev). SMTP transport arrives in Phase 8.
MAIL_TRANSPORT=log

# Swagger UI at /api/docs (defaults: on in dev, off in production)
# SWAGGER_ENABLED=true
LOG_LEVEL=info

# Seeding: SEED_DEMO=true creates a demo organization and one user per role
SEED_DEMO=false
SEED_DEFAULT_PASSWORD=ChangeMe@2026

# Product images. `local` writes under UPLOAD_DIR and serves them at /uploads (single server);
# use `s3` for any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO) in production.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_IMAGE_BYTES=2097152
# Expense receipts (JPEG, PNG, WebP or PDF)
UPLOAD_MAX_RECEIPT_BYTES=5242880
# S3_BUCKET=restaurantos-media
# S3_REGION=ap-south-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://media.example.com

# ── Realtime (WebSocket at /realtime, socket.io) ──
# How often committed changes are pushed to connected screens, and how long missed events can be replayed.
REALTIME_ENABLED=true
REALTIME_POLL_MS=200
REALTIME_RETENTION_HOURS=24
