  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@map("payment_allocations")
}

model Refund {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  paymentId      String            @map("payment_id") @db.Uuid // refunds always reference the original payment
  invoiceId      String            @map("invoice_id") @db.Uuid
  creditNoteId   String?           @map("credit_note_id") @db.Uuid
  method         PaymentMethod
  amount         Decimal           @db.Decimal(14, 2)
  reason         String
  status         TransactionStatus @default(COMPLETED)
  restock        Boolean           @default(false)
  cashSessionId  String?           @map("cash_session_id") @db.Uuid
  idempotencyKey String?           @map("idempotency_key") @db.VarChar(100)
  approvedById   String?           @map("approved_by_id") @db.Uuid
  processedById  String            @map("processed_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  payment    Payment     @relation(fields: [paymentId], references: [id])
  invoice    Invoice     @relation(fields: [invoiceId], references: [id])
  creditNote CreditNote? @relation(fields: [creditNoteId], references: [id])

  branch      Branch       @relation("Refund_branch", fields: [branchId, organizationId], references: [id, organizationId])
  cashSession CashSession? @relation("Refund_cashSession", fields: [cashSessionId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([invoiceId])
  @@map("refunds")
}

model CreditNote {
