// ───────────────────────────── Orders & KOT ─────────────────────────────

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  branchId        String        @map("branch_id") @db.Uuid
  orderNumber     String        @map("order_number") @db.VarChar(30)
  orderType       OrderType     @map("order_type")
  status          OrderStatus   @default(NEW)
  tableSessionId  String?       @map("table_session_id") @db.Uuid
  customerName    String?       @map("customer_name")
  customerPhone   String?       @map("customer_phone")
  deliveryAddress String?       @map("delivery_address")
  notes           String?
  guestCount      Int?          @map("guest_count")
  subtotal        Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal   Decimal       @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxableAmount   Decimal       @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  cgstAmount      Decimal       @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount      Decimal       @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount      Decimal       @default(0) @map("igst_amount") @db.Decimal(14, 2)
  taxTotal        Decimal       @default(0) @map("tax_total") @db.Decimal(14, 2)
  serviceCharge   Decimal       @default(0) @map("service_charge") @db.Decimal(14, 2)
  roundOff        Decimal       @default(0) @map("round_off") @db.Decimal(14, 2)
  grandTotal      Decimal       @default(0) @map("grand_total") @db.Decimal(14, 2)
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(14, 2)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  version         Int           @default(0) // optimistic concurrency
  createdById     String        @map("created_by_id") @db.Uuid
  confirmedAt     DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(3)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?       @map("cancelled_by_id") @db.Uuid
  cancelReason    String?       @map("cancel_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tableSession     TableSession?        @relation(fields: [tableSessionId], references: [id])
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  kitchenTickets   KitchenTicket[]
  invoices         Invoice[]
  appliedDiscounts AppliedDiscount[]

  branch          Branch    @relation("Order_branch", fields: [branchId, organizationId], references: [id, organizationId])
  paymentsByOrder Payment[] @relation("Payment_order")

  @@unique([branchId, orderNumber])
  @@index([organizationId, branchId, createdAt])
  @@index([branchId, status])
  @@map("orders")
}

model OrderItem {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  productId           String          @map("product_id") @db.Uuid
  variantId           String?         @map("variant_id") @db.Uuid
  // price & tax snapshots – never recomputed from the live menu
  productName         String          @map("product_name")
  variantName         String?         @map("variant_name")
  hsnSac              String?         @map("hsn_sac") @db.VarChar(8)
  stationCode         String?         @map("station_code") @db.VarChar(20)
  quantity            Decimal         @db.Decimal(14, 3)
  unitPrice           Decimal         @map("unit_price") @db.Decimal(14, 2)
  modifiersTotal      Decimal         @default(0) @map("modifiers_total") @db.Decimal(14, 2)
  priceIncludesTax    Boolean         @map("price_includes_tax")
  lineSubtotal        Decimal         @map("line_subtotal") @db.Decimal(14, 2)
  discountAmount      Decimal         @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxableAmount       Decimal         @map("taxable_amount") @db.Decimal(14, 2)
  taxRate             Decimal         @map("tax_rate") @db.Decimal(6, 3)
  cgstAmount          Decimal         @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount          Decimal         @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount          Decimal         @default(0) @map("igst_amount") @db.Decimal(14, 2)
  taxAmount           Decimal         @map("tax_amount") @db.Decimal(14, 2)
  lineTotal           Decimal         @map("line_total") @db.Decimal(14, 2)
  specialInstructions String?         @map("special_instructions")
  status              OrderItemStatus @default(ACTIVE)
  kitchenStatus       KitchenStatus   @default(PENDING) @map("kitchen_status")
  createdById         String          @map("created_by_id") @db.Uuid
  cancelledById       String?         @map("cancelled_by_id") @db.Uuid
  cancelledAt         DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelReason        String?         @map("cancel_reason")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  modifiers   OrderItemModifier[]
  ticketItems KitchenTicketItem[]

  product                     Product           @relation("OrderItem_product", fields: [productId], references: [id])
  variant                     ProductVariant?   @relation("OrderItem_variant", fields: [variantId], references: [id])
  appliedDiscountsByOrderItem AppliedDiscount[] @relation("AppliedDiscount_orderItem")
  invoiceItemsByOrderItem     InvoiceItem[]     @relation("InvoiceItem_orderItem")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemModifier {
  id          String  @id @default(uuid()) @db.Uuid
  orderItemId String  @map("order_item_id") @db.Uuid
  modifierId  String  @map("modifier_id") @db.Uuid
