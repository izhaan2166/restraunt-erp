/// Every discount actually applied to an order or line, with the actor who applied/approved it.
model AppliedDiscount {
  id           String        @id @default(uuid()) @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  orderItemId  String?       @map("order_item_id") @db.Uuid
  discountId   String?       @map("discount_id") @db.Uuid
  type         DiscountType
  scope        DiscountScope
  value        Decimal       @db.Decimal(14, 2)
  amount       Decimal       @db.Decimal(14, 2)
  reason       String?
  appliedById  String        @map("applied_by_id") @db.Uuid
  approvedById String?       @map("approved_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  order    Order     @relation(fields: [orderId], references: [id])
  discount Discount? @relation(fields: [discountId], references: [id])

  orderItem OrderItem? @relation("AppliedDiscount_orderItem", fields: [orderItemId], references: [id])

  @@index([orderId])
  @@map("applied_discounts")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  sequenceId     String        @map("sequence_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number") @db.VarChar(40)
  invoiceDate    DateTime      @default(now()) @map("invoice_date") @db.Timestamptz(3)
  status         InvoiceStatus @default(DRAFT)
  supplyType     SupplyType    @map("supply_type")
  placeOfSupply  String        @map("place_of_supply") @db.VarChar(2)
  sellerDetails  Json          @map("seller_details") // legal name, GSTIN, address snapshot
  buyerName      String?       @map("buyer_name")
  buyerGstin     String?       @map("buyer_gstin") @db.VarChar(15)
  subtotal       Decimal       @db.Decimal(14, 2)
  discountTotal  Decimal       @map("discount_total") @db.Decimal(14, 2)
  taxableAmount  Decimal       @map("taxable_amount") @db.Decimal(14, 2)
  cgstAmount     Decimal       @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount     Decimal       @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount     Decimal       @map("igst_amount") @db.Decimal(14, 2)
  taxTotal       Decimal       @map("tax_total") @db.Decimal(14, 2)
  serviceCharge  Decimal       @default(0) @map("service_charge") @db.Decimal(14, 2)
  roundOff       Decimal       @map("round_off") @db.Decimal(14, 2)
  grandTotal     Decimal       @map("grand_total") @db.Decimal(14, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(14, 2)
  refundedAmount Decimal       @default(0) @map("refunded_amount") @db.Decimal(14, 2)
  paymentStatus  PaymentStatus @default(UNPAID) @map("payment_status")
  createdById    String        @map("created_by_id") @db.Uuid
  finalizedById  String?       @map("finalized_by_id") @db.Uuid
  finalizedAt    DateTime?     @map("finalized_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order       Order               @relation(fields: [orderId], references: [id])
  items       InvoiceItem[]
  allocations PaymentAllocation[]
  refunds     Refund[]
  creditNotes CreditNote[]

  branch   Branch           @relation("Invoice_branch", fields: [branchId, organizationId], references: [id, organizationId])
  sequence DocumentSequence @relation("Invoice_sequence", fields: [sequenceId], references: [id])

  @@unique([sequenceId, invoiceNumber])
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, branchId, invoiceDate])
  @@index([orderId])
  @@map("invoices")
}

model InvoiceItem {
