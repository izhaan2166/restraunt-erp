  baseUnitId     String    @map("base_unit_id") @db.Uuid
  category       String?
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  balances  InventoryBalance[]
  movements StockMovement[]

  organization                   Organization        @relation("Ingredient_organization", fields: [organizationId], references: [id])
  baseUnit                       Unit                @relation("Ingredient_baseUnit", fields: [baseUnitId], references: [id])
  recipeItemsByIngredient        RecipeItem[]        @relation("RecipeItem_ingredient")
  stockAdjustmentsByIngredient   StockAdjustment[]   @relation("StockAdjustment_ingredient")
  wastageRecordsByIngredient     WastageRecord[]     @relation("WastageRecord_ingredient")
  purchaseOrderItemsByIngredient PurchaseOrderItem[] @relation("PurchaseOrderItem_ingredient")
  goodsReceiptItemsByIngredient  GoodsReceiptItem[]  @relation("GoodsReceiptItem_ingredient")

  @@unique([organizationId, name])
  @@map("ingredients")
}

model Recipe {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  yieldQuantity  Decimal  @default(1) @map("yield_quantity") @db.Decimal(14, 3)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product      @relation(fields: [productId], references: [id])
  items   RecipeItem[]

  organization Organization    @relation("Recipe_organization", fields: [organizationId], references: [id])
  variant      ProductVariant? @relation("Recipe_variant", fields: [variantId], references: [id])

  @@map("recipes")
}

model RecipeItem {
  id             String  @id @default(uuid()) @db.Uuid
  recipeId       String  @map("recipe_id") @db.Uuid
  ingredientId   String  @map("ingredient_id") @db.Uuid
  quantity       Decimal @db.Decimal(14, 3)
  unitId         String  @map("unit_id") @db.Uuid
  wastagePercent Decimal @default(0) @map("wastage_percent") @db.Decimal(6, 3)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  ingredient Ingredient @relation("RecipeItem_ingredient", fields: [ingredientId], references: [id])
  unit       Unit       @relation("RecipeItem_unit", fields: [unitId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_items")
}

model InventoryBalance {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  ingredientId   String   @map("ingredient_id") @db.Uuid
  quantity       Decimal  @default(0) @db.Decimal(14, 3) // in the ingredient's base unit
  minimumLevel   Decimal  @default(0) @map("minimum_level") @db.Decimal(14, 3)
  averageCost    Decimal  @default(0) @map("average_cost") @db.Decimal(14, 4) // per base unit
  version        Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  branch Branch @relation("InventoryBalance_branch", fields: [branchId, organizationId], references: [id, organizationId])

  @@unique([branchId, ingredientId])
  @@index([organizationId])
  @@map("inventory_balances")
}

/// Append-only stock ledger. dedupe_key makes each business event deduct stock at most once
/// (e.g. "order_item:<id>:consume").
model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  ingredientId   String            @map("ingredient_id") @db.Uuid
  type           StockMovementType
  quantity       Decimal           @db.Decimal(14, 3) // signed, base unit
  unitCost       Decimal?          @map("unit_cost") @db.Decimal(14, 4)
  balanceAfter   Decimal           @map("balance_after") @db.Decimal(14, 3)
  referenceType  String            @map("reference_type") @db.VarChar(40)
  referenceId    String            @map("reference_id") @db.Uuid
  dedupeKey      String            @unique @map("dedupe_key") @db.VarChar(150)
  note           String?
  createdById    String            @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  branch Branch @relation("StockMovement_branch", fields: [branchId, organizationId], references: [id, organizationId])

  @@index([branchId, ingredientId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model StockAdjustment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  ingredientId   String   @map("ingredient_id") @db.Uuid
  quantity       Decimal  @db.Decimal(14, 3) // signed, base unit
  reason         String
  createdById    String   @map("created_by_id") @db.Uuid
  approvedById   String?  @map("approved_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch     Branch     @relation("StockAdjustment_branch", fields: [branchId, organizationId], references: [id, organizationId])
  ingredient Ingredient @relation("StockAdjustment_ingredient", fields: [ingredientId], references: [id])

  @@index([branchId, createdAt])
  @@map("stock_adjustments")
}

model WastageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  ingredientId   String   @map("ingredient_id") @db.Uuid
  quantity       Decimal  @db.Decimal(14, 3) // base unit, positive
  cost           Decimal  @default(0) @db.Decimal(14, 2)
  reason         String
  recordedById   String   @map("recorded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch     Branch     @relation("WastageRecord_branch", fields: [branchId, organizationId], references: [id, organizationId])
  ingredient Ingredient @relation("WastageRecord_ingredient", fields: [ingredientId], references: [id])

  @@index([branchId, createdAt])
  @@map("wastage_records")
}

// ───────────────────────────── Purchasing ─────────────────────────────

model Supplier {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String
  contactPerson    String?   @map("contact_person")
  phone            String?
  email            String?
  gstin            String?   @db.VarChar(15)
  stateCode        String?   @map("state_code") @db.VarChar(2)
  address          String?
  paymentTermsDays Int       @default(0) @map("payment_terms_days")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]
  payments       SupplierPayment[]

  organization            Organization   @relation("Supplier_organization", fields: [organizationId], references: [id])
  goodsReceiptsBySupplier GoodsReceipt[] @relation("GoodsReceipt_supplier")

  @@unique([organizationId, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  supplierId     String              @map("supplier_id") @db.Uuid
  poNumber       String              @map("po_number") @db.VarChar(30)
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime            @default(now()) @map("order_date") @db.Timestamptz(3)
  expectedDate   DateTime?           @map("expected_date") @db.Timestamptz(3)
  subtotal       Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal             @default(0) @map("tax_total") @db.Decimal(14, 2)
  total          Decimal             @default(0) @db.Decimal(14, 2)
  notes          String?
  createdById    String              @map("created_by_id") @db.Uuid
  approvedById   String?             @map("approved_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  branch                          Branch            @relation("PurchaseOrder_branch", fields: [branchId, organizationId], references: [id, organizationId])
  supplierInvoicesByPurchaseOrder SupplierInvoice[] @relation("SupplierInvoice_purchaseOrder")

  @@unique([organizationId, poNumber])
  @@index([branchId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  ingredientId     String  @map("ingredient_id") @db.Uuid
  unitId           String  @map("unit_id") @db.Uuid
  quantity         Decimal @db.Decimal(14, 3)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(14, 3)
  unitPrice        Decimal @map("unit_price") @db.Decimal(14, 4)
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(6, 3)
  lineTotal        Decimal @map("line_total") @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  ingredient                           Ingredient         @relation("PurchaseOrderItem_ingredient", fields: [ingredientId], references: [id])
  unit                                 Unit               @relation("PurchaseOrderItem_unit", fields: [unitId], references: [id])
  goodsReceiptItemsByPurchaseOrderItem GoodsReceiptItem[] @relation("GoodsReceiptItem_purchaseOrderItem")

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  purchaseOrderId   String?  @map("purchase_order_id") @db.Uuid
  supplierId        String   @map("supplier_id") @db.Uuid
  supplierInvoiceId String?  @map("supplier_invoice_id") @db.Uuid
  grnNumber         String   @map("grn_number") @db.VarChar(30)
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  notes             String?
  receivedById      String   @map("received_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  items         GoodsReceiptItem[]

  branch          Branch           @relation("GoodsReceipt_branch", fields: [branchId, organizationId], references: [id, organizationId])
  supplier        Supplier         @relation("GoodsReceipt_supplier", fields: [supplierId], references: [id])
  supplierInvoice SupplierInvoice? @relation("GoodsReceipt_supplierInvoice", fields: [supplierInvoiceId], references: [id])

  @@unique([organizationId, grnNumber])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String  @id @default(uuid()) @db.Uuid
  goodsReceiptId      String  @map("goods_receipt_id") @db.Uuid
  purchaseOrderItemId String? @map("purchase_order_item_id") @db.Uuid
  ingredientId        String  @map("ingredient_id") @db.Uuid
  unitId              String  @map("unit_id") @db.Uuid
  quantity            Decimal @db.Decimal(14, 3)
  baseQuantity        Decimal @map("base_quantity") @db.Decimal(14, 3)
  unitPrice           Decimal @map("unit_price") @db.Decimal(14, 4)

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  purchaseOrderItem PurchaseOrderItem? @relation("GoodsReceiptItem_purchaseOrderItem", fields: [purchaseOrderItemId], references: [id])
  ingredient        Ingredient         @relation("GoodsReceiptItem_ingredient", fields: [ingredientId], references: [id])
  unit              Unit               @relation("GoodsReceiptItem_unit", fields: [unitId], references: [id])

  @@map("goods_receipt_items")
}

model SupplierInvoice {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  branchId        String                @map("branch_id") @db.Uuid
  supplierId      String                @map("supplier_id") @db.Uuid
  purchaseOrderId String?               @map("purchase_order_id") @db.Uuid
  invoiceNumber   String                @map("invoice_number") @db.VarChar(40)
  invoiceDate     DateTime              @map("invoice_date") @db.Date
  dueDate         DateTime?             @map("due_date") @db.Date
  subtotal        Decimal               @db.Decimal(14, 2)
  taxTotal        Decimal               @map("tax_total") @db.Decimal(14, 2)
  total           Decimal               @db.Decimal(14, 2)
  paidAmount      Decimal               @default(0) @map("paid_amount") @db.Decimal(14, 2)
  status          SupplierInvoiceStatus @default(UNPAID)
  attachmentUrl   String?               @map("attachment_url")
  createdById     String                @map("created_by_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier Supplier          @relation(fields: [supplierId], references: [id])
  payments SupplierPayment[]

  branch                         Branch         @relation("SupplierInvoice_branch", fields: [branchId, organizationId], references: [id, organizationId])
  goodsReceiptsBySupplierInvoice GoodsReceipt[] @relation("GoodsReceipt_supplierInvoice")
  purchaseOrder                  PurchaseOrder? @relation("SupplierInvoice_purchaseOrder", fields: [purchaseOrderId], references: [id])

  @@unique([supplierId, invoiceNumber])
  @@map("supplier_invoices")
}

model SupplierPayment {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  branchId          String?       @map("branch_id") @db.Uuid
  supplierId        String        @map("supplier_id") @db.Uuid
  supplierInvoiceId String?       @map("supplier_invoice_id") @db.Uuid
  amount            Decimal       @db.Decimal(14, 2)
  method            PaymentMethod
  reference         String?
  idempotencyKey    String?       @map("idempotency_key") @db.VarChar(100)
  paidById          String        @map("paid_by_id") @db.Uuid
  paidAt            DateTime      @default(now()) @map("paid_at") @db.Timestamptz(3)

  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  supplierInvoice SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id])

  branch Branch? @relation("SupplierPayment_branch", fields: [branchId, organizationId], references: [id, organizationId])

  @@unique([organizationId, idempotencyKey])
  @@map("supplier_payments")
}

// ───────────────────────────── Finance ─────────────────────────────

model ExpenseCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  expenses Expense[]

  organization Organization @relation("ExpenseCategory_organization", fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("expense_categories")
}

model Expense {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  description    String
  expenseDate    DateTime      @map("expense_date") @db.Date
  paymentMethod  PaymentMethod @map("payment_method")
  paidTo         String?       @map("paid_to")
  employeeId     String?       @map("employee_id") @db.Uuid
  receiptUrl     String?       @map("receipt_url")
  cashSessionId  String?       @map("cash_session_id") @db.Uuid
  createdById    String        @map("created_by_id") @db.Uuid
  updatedById    String?       @map("updated_by_id") @db.Uuid
  deletedById    String?       @map("deleted_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)

  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  branch      Branch       @relation("Expense_branch", fields: [branchId, organizationId], references: [id, organizationId])
  employee    Employee?    @relation("Expense_employee", fields: [employeeId], references: [id])
  cashSession CashSession? @relation("Expense_cashSession", fields: [cashSessionId], references: [id])

  @@index([organizationId, branchId, expenseDate])
  @@map("expenses")
}

model CashSession {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  terminal       String?           @db.VarChar(40)
  status         CashSessionStatus @default(OPEN)
  openingBalance Decimal           @map("opening_balance") @db.Decimal(14, 2)
  openedAt       DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  expectedCash   Decimal?          @map("expected_cash") @db.Decimal(14, 2)
  actualCash     Decimal?          @map("actual_cash") @db.Decimal(14, 2)
  discrepancy    Decimal?          @db.Decimal(14, 2)
  closingNotes   String?           @map("closing_notes")
  closedById     String?           @map("closed_by_id") @db.Uuid
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz(3)

  movements CashMovement[]

  branch                Branch    @relation("CashSession_branch", fields: [branchId, organizationId], references: [id, organizationId])
  paymentsByCashSession Payment[] @relation("Payment_cashSession")
  refundsByCashSession  Refund[]  @relation("Refund_cashSession")
  expensesByCashSession Expense[] @relation("Expense_cashSession")
  user                  User      @relation("CashSession_user", fields: [userId], references: [id])

  @@index([branchId, status])
  @@map("cash_sessions")
}

model CashMovement {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  branchId       String           @map("branch_id") @db.Uuid
  cashSessionId  String           @map("cash_session_id") @db.Uuid
  type           CashMovementType
  amount         Decimal          @db.Decimal(14, 2) // signed: + into drawer, − out of drawer
  referenceType  String?          @map("reference_type") @db.VarChar(40)
  referenceId    String?          @map("reference_id") @db.Uuid
  note           String?
  createdById    String           @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  cashSession CashSession @relation(fields: [cashSessionId], references: [id])

  branch Branch @relation("CashMovement_branch", fields: [branchId, organizationId], references: [id, organizationId])

  @@index([cashSessionId])
  @@map("cash_movements")
}

// ───────────────────────────── Employees ─────────────────────────────

model Employee {
