// RestaurantOS – PostgreSQL schema
// Conventions:
//  * snake_case tables and columns (@@map / @map), UUID primary keys.
//  * Money:    Decimal(14,2). Quantities: Decimal(14,3). Rates: Decimal(6,3). Costs: Decimal(14,4).
//  * Every restaurant-owned row carries organization_id and, where it belongs to an outlet, branch_id.
//  * Check constraints, partial unique indexes and integrity triggers that Prisma cannot express
//    live in the raw SQL part of the migrations (see prisma/migrations/*/migration.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  SERVED
  OUT_FOR_DELIVERY
  DELIVERED
  PICKED_UP
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
}

enum KitchenStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum SupplyType {
  INTRA_STATE
  INTER_STATE
}

enum TaxPricingMode {
  INCLUSIVE
  EXCLUSIVE
}

enum RoundingMode {
  NEAREST_RUPEE
  NEAREST_PAISA
}

enum StockDeductionPolicy {
  ON_ORDER_CONFIRM
  ON_ORDER_COMPLETE
  NONE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  BILL_PENDING
  OUT_OF_SERVICE
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  WALLET
  BANK_TRANSFER
  OTHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  VOIDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountScope {
  ORDER
  ITEM
}

enum UnitDimension {
  MASS
  VOLUME
  COUNT
}

enum StockMovementType {
  OPENING
  PURCHASE_RECEIPT
  SALE_CONSUMPTION
  SALE_REVERSAL
  WASTAGE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING_FLOAT
  CASH_SALE
  CASH_REFUND
  CASH_IN
  CASH_OUT
  EXPENSE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum SequenceType {
  ORDER
  KOT
  INVOICE
  CREDIT_NOTE
  PURCHASE_ORDER
  GOODS_RECEIPT
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ───────────────────────────── Organization ─────────────────────────────

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  legalName String?   @map("legal_name")
  gstin     String?   @db.VarChar(15)
  pan       String?   @db.VarChar(10)
  stateCode String?   @map("state_code") @db.VarChar(2)
  address   String?
  phone     String?
  email     String?
  timezone  String    @default("Asia/Kolkata")
  currency  String    @default("INR") @db.VarChar(3)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  branches Branch[]
  users    User[]
  roles    Role[]

  categorys        Category[]        @relation("Category_organization")
  taxRates         TaxRate[]         @relation("TaxRate_organization")
  products         Product[]         @relation("Product_organization")
  modifierGroups   ModifierGroup[]   @relation("ModifierGroup_organization")
  ingredients      Ingredient[]      @relation("Ingredient_organization")
  recipes          Recipe[]          @relation("Recipe_organization")
  suppliers        Supplier[]        @relation("Supplier_organization")
  expenseCategorys ExpenseCategory[] @relation("ExpenseCategory_organization")
  employees        Employee[]        @relation("Employee_organization")
  idempotencyKeys  IdempotencyKey[]  @relation("IdempotencyKey_organization")
  sessions         Session[]         @relation("Session_organization")

  @@map("organizations")
}

model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String    @db.VarChar(20)
  name           String
  gstin          String?   @db.VarChar(15)
  stateCode      String    @map("state_code") @db.VarChar(2)
  address        String?
  city           String?
  pincode        String?   @db.VarChar(6)
  phone          String?
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id])
  settings     BranchSettings?
  userRoles    UserRole[]

  documentSequences        DocumentSequence[]   @relation("DocumentSequence_branch")
  restaurantTables         RestaurantTable[]    @relation("RestaurantTable_branch")
  tableSessions            TableSession[]       @relation("TableSession_branch")
  kitchenStations          KitchenStation[]     @relation("KitchenStation_branch")
  orders                   Order[]              @relation("Order_branch")
  kitchenTickets           KitchenTicket[]      @relation("KitchenTicket_branch")
  invoices                 Invoice[]            @relation("Invoice_branch")
  payments                 Payment[]            @relation("Payment_branch")
  refunds                  Refund[]             @relation("Refund_branch")
  creditNotes              CreditNote[]         @relation("CreditNote_branch")
  inventoryBalances        InventoryBalance[]   @relation("InventoryBalance_branch")
  stockMovements           StockMovement[]      @relation("StockMovement_branch")
  stockAdjustments         StockAdjustment[]    @relation("StockAdjustment_branch")
  wastageRecords           WastageRecord[]      @relation("WastageRecord_branch")
  purchaseOrders           PurchaseOrder[]      @relation("PurchaseOrder_branch")
  goodsReceipts            GoodsReceipt[]       @relation("GoodsReceipt_branch")
  supplierInvoices         SupplierInvoice[]    @relation("SupplierInvoice_branch")
  expenses                 Expense[]            @relation("Expense_branch")
  cashSessions             CashSession[]        @relation("CashSession_branch")
  cashMovements            CashMovement[]       @relation("CashMovement_branch")
  attendances              Attendance[]         @relation("Attendance_branch")
  employeeShifts           EmployeeShift[]      @relation("EmployeeShift_branch")
  discounts                Discount[]           @relation("Discount_branch")
  supplierPayments         SupplierPayment[]    @relation("SupplierPayment_branch")
  notifications            Notification[]       @relation("Notification_branch")
  employeesByPrimaryBranch Employee[]           @relation("Employee_primaryBranch")
  branchProductPrices      BranchProductPrice[] @relation("BranchProductPrice_branch")

  @@unique([organizationId, code])
  @@unique([id, organizationId]) // lets child tables enforce branch ∈ organization
  @@index([organizationId])
  @@map("branches")
}

model BranchSettings {
  branchId              String               @id @map("branch_id") @db.Uuid
  organizationId        String               @map("organization_id") @db.Uuid
  taxPricingMode        TaxPricingMode       @default(EXCLUSIVE) @map("tax_pricing_mode")
  roundingMode          RoundingMode         @default(NEAREST_RUPEE) @map("rounding_mode")
  invoicePrefix         String               @default("INV") @map("invoice_prefix") @db.VarChar(10)
  stockDeductionPolicy  StockDeductionPolicy @default(ON_ORDER_COMPLETE) @map("stock_deduction_policy")
  allowNegativeStock    Boolean              @default(true) @map("allow_negative_stock")
  serviceChargePercent  Decimal              @default(0) @map("service_charge_percent") @db.Decimal(6, 3)
  maxCashierDiscountPct Decimal              @default(10) @map("max_cashier_discount_pct") @db.Decimal(6, 3)
  extra                 Json                 @default("{}")
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId])

  @@unique([branchId, organizationId])
  @@map("branch_settings")
}

model DocumentSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  type           SequenceType
  prefix         String       @db.VarChar(16)
  period         String       @db.VarChar(10) // e.g. financial year "2026-27" or day "20261106" for KOTs
  nextValue      Int          @default(1) @map("next_value")
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch                Branch       @relation("DocumentSequence_branch", fields: [branchId, organizationId], references: [id, organizationId])
  invoicesBySequence    Invoice[]    @relation("Invoice_sequence")
  creditNotesBySequence CreditNote[] @relation("CreditNote_sequence")

  @@unique([branchId, type, prefix, period])
  @@index([organizationId])
  @@map("document_sequences")
}

// ───────────────────────────── Authentication & RBAC ─────────────────────────────

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  email               String    @unique // stored lower-cased
  phone               String?
  fullName            String    @map("full_name")
  passwordHash        String    @map("password_hash")
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)
  createdById         String?   @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id])
  userRoles           UserRole[]           @relation("UserRoleUser")
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  employee            Employee?

  cashSessionsByUser            CashSession[]       @relation("CashSession_user")
  kitchenTicketItemsByUpdatedBy KitchenTicketItem[] @relation("KitchenTicketItem_updatedBy")

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(50) // SUPER_ADMIN, OWNER, MANAGER, ... or custom
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, key])
  @@unique([id, organizationId])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(80) // e.g. "billing.discount.apply"
  module      String @db.VarChar(40)
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedById  String?  @map("granted_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// branch_id NULL = the role applies to every branch of the organization.
model UserRole {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  assignedById   String?  @map("assigned_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation("UserRoleUser", fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  role   Role    @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, roleId, branchId], map: "user_roles_user_role_branch_key") // NULLS NOT DISTINCT (see SQL migration)
  @@index([userId])
  @@index([organizationId])
  @@map("user_roles")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  ip             String?
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt     DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason   String?   @map("revoke_reason")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  organization Organization @relation("Session_organization", fields: [organizationId], references: [id])

  @@index([userId])
  @@map("sessions")
}

/// Opaque refresh tokens, stored as SHA-256 hashes. Rotated on every use; reuse of a
/// rotated token revokes the whole session (token-family reuse detection).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ───────────────────────────── Tables & floor ─────────────────────────────

model RestaurantTable {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  branchId         String      @map("branch_id") @db.Uuid
  label            String      @db.VarChar(20)
  area             String?     @db.VarChar(50)
  capacity         Int
  status           TableStatus @default(AVAILABLE)
  shape            String      @default("RECT") @db.VarChar(10)
  posX             Int         @default(0) @map("pos_x")
  posY             Int         @default(0) @map("pos_y")
  width            Int         @default(80)
  height           Int         @default(80)
  isActive         Boolean     @default(true) @map("is_active")
  reservationName  String?     @map("reservation_name")
  reservationPhone String?     @map("reservation_phone") @db.VarChar(16)
  reservedUntil    DateTime?   @map("reserved_until") @db.Timestamptz(3)
  version          Int         @default(0)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(3)

  sessions TableSession[]

  branch Branch @relation("RestaurantTable_branch", fields: [branchId, organizationId], references: [id, organizationId])

  @@unique([branchId, label])
  @@index([organizationId, branchId])
  @@map("restaurant_tables")
}

model TableSession {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  tableId        String    @map("table_id") @db.Uuid
  guestCount     Int       @default(1) @map("guest_count")
  mergedIntoId   String?   @map("merged_into_id") @db.Uuid
  openedById     String    @map("opened_by_id") @db.Uuid
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedById     String?   @map("closed_by_id") @db.Uuid
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(3)

  table      RestaurantTable @relation(fields: [tableId], references: [id])
  mergedInto TableSession?   @relation("TableSessionMerge", fields: [mergedIntoId], references: [id])
  merged     TableSession[]  @relation("TableSessionMerge")
  orders     Order[]

  branch Branch @relation("TableSession_branch", fields: [branchId, organizationId], references: [id, organizationId])

  @@index([branchId, closedAt])
  @@map("table_sessions")
}

// ───────────────────────────── Menu ─────────────────────────────

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  name           String
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  organization Organization @relation("Category_organization", fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("categories")
}

model TaxRate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String // "GST 5% (Restaurant)"
  rate           Decimal   @db.Decimal(6, 3) // total GST rate
  cgstRate       Decimal   @map("cgst_rate") @db.Decimal(6, 3)
  sgstRate       Decimal   @map("sgst_rate") @db.Decimal(6, 3)
  igstRate       Decimal   @map("igst_rate") @db.Decimal(6, 3)
  cessRate       Decimal   @default(0) @map("cess_rate") @db.Decimal(6, 3)
  isActive       Boolean   @default(true) @map("is_active")
  effectiveFrom  DateTime  @default(now()) @map("effective_from") @db.Timestamptz(3)
  effectiveTo    DateTime? @map("effective_to") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  organization Organization @relation("TaxRate_organization", fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("tax_rates")
}

model KitchenStation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  code           String   @db.VarChar(20)
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tickets KitchenTicket[]

  branch Branch @relation("KitchenStation_branch", fields: [branchId, organizationId], references: [id, organizationId])

  @@unique([branchId, code])
  @@map("kitchen_stations")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  taxRateId      String?   @map("tax_rate_id") @db.Uuid
  sku            String    @db.VarChar(40)
  name           String
  description    String?
  imageUrl       String?   @map("image_url")
  basePrice      Decimal   @map("base_price") @db.Decimal(14, 2)
  hsnSac         String?   @map("hsn_sac") @db.VarChar(8)
  isVeg          Boolean   @default(true) @map("is_veg")
  stationCode    String?   @map("station_code") @db.VarChar(20) // routes KOT lines to a kitchen station
  isCombo        Boolean   @default(false) @map("is_combo")
  isActive       Boolean   @default(true) @map("is_active")
  isAvailable    Boolean   @default(true) @map("is_available") // temporary 86
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  category       Category               @relation(fields: [categoryId], references: [id])
  taxRate        TaxRate?               @relation(fields: [taxRateId], references: [id])
  variants       ProductVariant[]
  modifierGroups ProductModifierGroup[]
  branchPrices   BranchProductPrice[]
  comboItems     ComboItem[]            @relation("ComboParent")
  inCombos       ComboItem[]            @relation("ComboChild")
  recipes        Recipe[]

  organization        Organization @relation("Product_organization", fields: [organizationId], references: [id])
  orderItemsByProduct OrderItem[]  @relation("OrderItem_product")

  @@unique([organizationId, sku])
  @@index([organizationId, categoryId])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  name      String // "Half", "Full", "Large"
  price     Decimal  @db.Decimal(14, 2) // absolute price of this variant
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  branchProductPricesByVariant BranchProductPrice[] @relation("BranchProductPrice_variant")
  comboItemsByVariant          ComboItem[]          @relation("ComboItem_variant")
  recipesByVariant             Recipe[]             @relation("Recipe_variant")
  orderItemsByVariant          OrderItem[]          @relation("OrderItem_variant")

  @@unique([productId, name])
  @@map("product_variants")
}

model ModifierGroup {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String // "Extra toppings"
  minSelect      Int      @default(0) @map("min_select")
  maxSelect      Int      @default(1) @map("max_select")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  modifiers Modifier[]
  products  ProductModifierGroup[]

