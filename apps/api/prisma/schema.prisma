model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  branchId       String           @map("branch_id") @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  workDate       DateTime         @map("work_date") @db.Date
  status         AttendanceStatus @default(PRESENT)
  clockInAt      DateTime?        @map("clock_in_at") @db.Timestamptz(3)
  clockOutAt     DateTime?        @map("clock_out_at") @db.Timestamptz(3)
  notes          String?
  recordedById   String?          @map("recorded_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  branch Branch @relation("Attendance_branch", fields: [branchId, organizationId], references: [id, organizationId])

  @@unique([employeeId, workDate])
  @@map("attendance")
}

model EmployeeShift {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  scheduledStart DateTime  @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd   DateTime  @map("scheduled_end") @db.Timestamptz(3)
  actualStart    DateTime? @map("actual_start") @db.Timestamptz(3)
  actualEnd      DateTime? @map("actual_end") @db.Timestamptz(3)
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  branch Branch @relation("EmployeeShift_branch", fields: [branchId, organizationId], references: [id, organizationId])

  @@index([branchId, scheduledStart])
  @@map("employee_shifts")
