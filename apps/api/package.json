{
  "name": "@restaurant-os/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build && tsc -p tsconfig.seed.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.ts",
    "test:e2e": "jest --config test/jest-e2e.config.ts --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:seed:prod": "node dist-seed/prisma/seed.js",
    "db:drift-check": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.8",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "nestjs-pino": "4.6.1",
    "pino": "^9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "29.7.0",
    "pino-pretty": "^13.2.0",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
