  "info": {
    "title": "RestaurantOS API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "Object": {
        "type": "object",
        "properties": {}
      },
      "CreateRoleDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "SHIFT_SUPERVISOR",
            "description": "UPPER_SNAKE_CASE, unique within the organization"
          },
          "name": {
            "type": "string",
            "example": "Shift Supervisor"
          },
          "description": {
            "type": "string"
          },
          "permissions": {
            "example": [
              "orders.read",
              "orders.cancel"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "key",
          "name",
          "permissions"
        ]
      },
      "UpdateRolePermissionsDto": {
        "type": "object",
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "permissions"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "cashier.blr@spiceroute.example"
          },
          "password": {
            "type": "string",
            "example": "ChangeMe@2026"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenPairResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds until the access token expires"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshExpiresAt": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken",
          "refreshExpiresAt"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token. Browsers send it as the httpOnly `ros_rt` cookie instead."
          }
        }
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "UpdateOrganizationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "legalName": {
            "type": "string"
          },
          "gstin": {
            "type": "string",
            "example": "29ABCDE1234F1Z5"
          },
          "pan": {
            "type": "string"
          },
          "stateCode": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "CreateBranchDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "BLR-IND"
          },
          "name": {
            "type": "string",
            "example": "Spice Route – Indiranagar"
